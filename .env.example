# Required
NODE_ENV=development
PORT=3000
# Docker only: host port for the web container (change if 3000 is already in use; then update APP_URL too)
WEB_PORT=3000
APP_URL=http://localhost:3000
# Set to true behind an HTTPS reverse proxy in production.
TRUST_PROXY=false
POSTGRES_PASSWORD=change-this-to-a-strong-local-password
APP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=postgres://nugas_user:change-this-to-a-strong-local-password@localhost:5432/nugas

# SMS (Kavenegar). If empty, OTP is not sent in production.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Initial owner account; used only by npm run admin:create. Choose a unique username and a strong password.
ADMIN_USERNAME=site_owner
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Dev only: show the OTP in the server console for local testing.
SHOW_DEV_OTP=false

# ZarinPal (prices are entered in Toman; gateway amount is sent in Rial)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Upload handling
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Optional
# PGSSLMODE=require          # managed PostgreSQL with TLS
# DB_POOL_SIZE=10
# LOG_LEVEL=info             # debug | info | warn | error
# SHUTDOWN_TIMEOUT_MS=10000

# Tests only: a DISPOSABLE database whose name contains "test" (its schema is dropped).
# TEST_DATABASE_URL=postgres://nugas_user:password@localhost:5432/nugas_test

# --- Hormozgan coverage map ---
# Public page /coverage-map is hidden (404) until this is true; content admins can always preview it.
FEATURE_COVERAGE_MAP=false
# Map.ir API key (from https://corp.map.ir → API keys). Free-plan keys expire after about a month: the
# admin dashboard warns 7 days ahead, and an expired/missing key falls back to OpenStreetMap/CARTO tiles.
# Never commit the real key.
MAPIR_API_KEY=

# --- «دستیار مبحث ۱۷» (AI Q&A) ---
# Page /assistant is hidden until this is true. Without AI_API_KEY it still answers with matching clauses (no AI).
FEATURE_AI_ASSISTANT=false
# GapGPT (OpenAI-compatible) key — server only, never commit it. Rotate it in the GapGPT panel if it leaks.
AI_API_KEY=
AI_BASE_URL=https://api.gapapi.com/v1
# Optional overrides of the models chosen by evals (src/lib/ai/models.js)
AI_MODEL_ANSWER=
AI_MODEL_EMBED=
# Budget guard: when either daily ceiling is reached, the assistant falls back to clause search.
AI_DAILY_REQUEST_LIMIT=300
AI_DAILY_TOKEN_LIMIT=3000000
