<!doctype html>
<html lang="<%= htmlLang %>" dir="<%= htmlDir %>" data-locale="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3f6f2">
  <!-- Novingity site icons -->
  <link rel="icon" href="/public/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/public/favicon-48x48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/public/apple-touch-icon.png">
  <link rel="manifest" href="/public/site.webmanifest">
<%
  const pageDescription = typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('meta.defaultDescription');
  const pageTitle = locals.fullTitle && title ? title : (title ? `${title} | ${siteName}` : `${siteName} | ${t('meta.defaultTitleSuffix')}`);
  const s = locals.seo;
  const isError = locals.httpStatus && locals.httpStatus() >= 400;
  const ogDefault = locals.siteImage ? siteImage('seo.ogDefault') : null;
  // Priority: page image (product/article cover) > admin-set default > per-page share card > brand picture.
  const ogImageUrl = locals.ogImage || `${locals.appUrl}${ogDefault && ogDefault.custom ? ogDefault.src : (locals.ogCard || '/public/images/og-default.png')}`;
%>
  <meta name="description" content="<%= pageDescription %>">
  <title><%= pageTitle %></title>
<% if (s) { %>
  <% if (s.noindex || isError) { %><meta name="robots" content="noindex, follow"><% } else { %>
  <%# Pages whose English version is not written yet (products/articles without English content) are only Persian:
      no en alternate, and the ?lang=en view canonicalises to the Persian URL. %>
  <% const noEnglish = locals.englishAvailable === false; %>
  <link rel="canonical" href="<%= noEnglish ? s.alternates.fa : s.canonical %>">
  <link rel="alternate" hreflang="fa" href="<%= s.alternates.fa %>">
  <% if (!noEnglish) { %><link rel="alternate" hreflang="en" href="<%= s.alternates.en %>"><% } %>
  <link rel="alternate" hreflang="x-default" href="<%= s.alternates.fa %>"><% } %>
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:type" content="<%= locals.ogType === 'article' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= locals.fullTitle && title ? title : (title || siteName) %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= s.canonical %>">
  <meta property="og:image" content="<%= ogImageUrl %>">
  <% if (!locals.ogImage && !(ogDefault && ogDefault.custom)) { %><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><% } else if (!locals.ogImage && ogDefault.width) { %><meta property="og:image:width" content="<%= ogDefault.width %>"><meta property="og:image:height" content="<%= ogDefault.height %>"><% } %>
  <meta property="og:locale" content="<%= s.ogLocale %>">
  <meta property="og:locale:alternate" content="<%= s.ogLocaleAlternate %>">
  <meta name="twitter:card" content="summary_large_image">
  <% if (!s.noindex && !isError) { %><script type="application/ld+json"><%- locals.seoJsonLd(locals.structuredData || []) %></script><% } %>
<% } %>
  <link rel="preload" href="/public/fonts/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/public/css/styles.css?v=<%= locals.assetVersion || '0' %>">
  <link rel="stylesheet" href="/public/css/elevate.css?v=<%= locals.assetVersion || '0' %>">
  <link rel="stylesheet" href="/public/css/banners.css?v=<%= locals.assetVersion || '0' %>">
  <%# Scroll-reveal content starts hidden and is shown by motion.js; without JavaScript it must simply be visible. %>
  <noscript><style>.reveal-on-scroll,.reveal-stagger .reveal-item{opacity:1!important;transform:none!important}</style></noscript>
  <script defer src="/public/js/main.js?v=<%= locals.assetVersion || '0' %>"></script>
  <script defer src="/public/js/motion.js?v=<%= locals.assetVersion || '0' %>"></script>
</head>
<body class="<%= String(locals.currentPath || '').startsWith('/admin') ? 'is-admin' : 'is-public' %>">
<a class="skip-link" href="#main-content"><%= t('a11y.skipToContent') %></a>
<%- include('announcement-bar') %>
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="<%= siteName %> - <%= t('a11y.homeLink') %>"><span class="brand-mark"><%- include('brand-logo') %></span><span><strong><%= siteName %></strong><small><%= siteTagline %></small></span></a>
    <button class="mobile-toggle" type="button" aria-label="<%= t('a11y.openMenu') %>" aria-controls="main-nav" aria-expanded="false" data-menu-toggle><span></span><span></span><span></span></button>
    <nav class="main-nav" id="main-nav" aria-label="<%= t('a11y.mainMenu') %>" data-nav>
      <a href="/tools"><%= t('nav.tools') %></a>
<% if (locals.aiAssistantEnabled) { %>      <a href="/assistant"><%= t('nav.assistant') %></a>
<% } %>      <a href="/shop"><%= t('nav.shop') %></a>
      <a href="/articles"><%= t('nav.articles') %></a>
      <a href="/library"><%= t('nav.library') %></a>
<% if (coverageMapEnabled) { %>      <a href="/coverage-map"><%= t('nav.coverageMap') %></a>
<% } %>      <a href="/about"><%= t('nav.about') %></a>
      <a href="/support"><%= t('nav.support') %><% if (locals.supportUnread) { %> <span class="nav-badge" aria-label="<%= t('support.newReplies') %>"><%= supportUnread %></span><% } %></a>
      <% if (currentAdmin) { %><a href="<%= can('overview') ? '/admin' : (roleHome || '/admin/account') %>" class="nav-admin"><%= t('nav.admin') %></a><% } %>
    </nav>
    <div class="nav-actions">
      <div class="lang-switch" role="group" aria-label="<%= t('nav.language') %>">
        <a href="/lang/fa?next=<%= encodeURIComponent(currentPath) %>" class="lang-option <%= locale==='fa'?'is-active':'' %>" lang="fa">فا</a>
        <a href="/lang/en?next=<%= encodeURIComponent(currentPath) %>" class="lang-option <%= locale==='en'?'is-active':'' %>" lang="en">EN</a>
      </div>
      <% if (currentAdmin) { %>
        <a class="user-chip" href="/admin/account" title="<%= currentAdmin.username %>"><span class="avatar-mini" aria-hidden="true"><%= currentAdmin.username.slice(0,1).toUpperCase() %></span><span class="user-chip-name"><%= currentAdmin.username %></span></a>
        <form action="/admin/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit"><%= t('nav.adminLogout') %></button></form>
      <% } else if (currentUser) { %>
        <a class="user-chip" href="/account"><span class="avatar-mini" aria-hidden="true"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></span><span class="user-chip-name"><%= currentUser.first_name || t('nav.account') %></span></a>
        <form action="/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit"><%= t('nav.logout') %></button></form>
      <% } else { %>
        <a class="button button-dark button-small" href="/login"><%= t('nav.login') %></a>
      <% } %>
    </div>
  </div>
</header>
<% if (flash) { %><div class="container flash-wrap"><div class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %><button type="button" aria-label="<%= t('a11y.closeMessage') %>" data-flash-close>×</button></div></div><% } %>
<main id="main-content" tabindex="-1">
